# Local development placeholders. Copy to .env and replace before sharing an instance.
# PostgreSQL — one database and user per service
POSTGRES_PASSWORD=postgres_root_pass

AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass
AUTH_DB_URL=jdbc:postgresql://postgres:5432/auth_db

WALLET_DB_NAME=wallet_db
WALLET_DB_USER=wallet_user
WALLET_DB_PASSWORD=wallet_pass
WALLET_DB_URL=jdbc:postgresql://postgres:5432/wallet_db

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=notification_pass
NOTIFICATION_DB_URL=jdbc:postgresql://postgres:5432/notification_db

# Wallet limits in USD cents
WALLET_MIN_AMOUNT=1
WALLET_MAX_AMOUNT=200000
WALLET_DAILY_LIMIT=500000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Bank integration
BANK_API_KEY=change-me-bank-api-key
BANK_BASE_URL=http://bank-simulator:8083
BANK_TIMEOUT=3s
BANK_WEBHOOK_SECRET=change-me-webhook-secret

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
JWT_ISSUER=digital-wallet-auth

# Observability
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
