{
  "uid": "wallet-traces",
  "title": "Digital Wallet Traces",
  "schemaVersion": 39,
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [
    {"name": "traceId", "label": "Trace ID", "type": "textbox", "query": "", "current": {"text": "", "value": ""}}
  ]},
  "panels": [
    {
      "id": 1,
      "title": "Recent traces",
      "type": "table",
      "datasource": {"type": "tempo", "uid": "tempo"},
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 12},
      "targets": [{"refId": "A", "queryType": "traceql", "query": "{ resource.service.name != nil }", "tableType": "traces", "limit": 30}],
      "fieldConfig": {"defaults": {}, "overrides": [
        {"matcher": {"id": "byName", "options": "Trace ID"}, "properties": [
          {"id": "links", "value": [{"title": "View spans", "url": "/d/wallet-traces/digital-wallet-traces?var-traceId=${__value.raw}"}]}
        ]}
      ]}
    },
    {
      "id": 2,
      "title": "Spans for selected trace",
      "type": "traces",
      "datasource": {"type": "tempo", "uid": "tempo"},
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 14},
      "targets": [{"refId": "A", "queryType": "traceql", "query": "${traceId}"}]
    }
  ]
}
